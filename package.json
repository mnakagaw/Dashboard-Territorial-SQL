{
  "name": "dashboard-diagnostico-territorial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:sqlite": "vite build --mode sqlite && node scripts/postbuild.mjs",
    "build:one": "vite build --mode one && node scripts/postbuild.mjs && node scripts/prepare_one_web.mjs",
    "build:node18": "npx --yes node@18 ./node_modules/vite/bin/vite.js build && npx --yes node@18 scripts/postbuild.mjs",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "deploy:one": "node scripts/deploy_one.mjs",
    "deploy:one:sqlite": "node scripts/deploy_one_sqlite.mjs",
    "sqlite:init": "python scripts/sqlite_tool.py init",
    "sqlite:verify": "python scripts/sqlite_tool.py verify",
    "sqlite:list": "python scripts/sqlite_tool.py list",
    "sqlite:serve": "python scripts/sqlite_server.py",
    "handoff:one": "python scripts/prepare_one_handoff.py",
    "data:fetch:population-final": "node scripts/fetch_final_population_2022.mjs",
    "data:rebuild:audit": "python scripts/rebuild_audited_assets.py",
    "verify:data": "node scripts/verify_data_integrity.cjs",
    "verify:province-names": "node scripts/verify_province_names.cjs",
    "verify": "npm run verify:data && npm run verify:province-names",
    "verify:one:remote": "node scripts/verify_one_remote.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "mysql2": "^3.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.6.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.0",
    "basic-ftp": "^5.2.0",
    "dotenv": "^17.3.1",
    "esbuild": "^0.27.3",
    "esbuild-wasm": "^0.27.3",
    "jsdom": "^28.1.0",
    "mssql": "^12.7.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
